# ------------------------------------------------------------------
# QuizCraft Backend Environment Variables (placeholders only)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Example for local MongoDB:
#   mongodb://127.0.0.1:27017/quizcraft
#
# NOTE: If MongoDB is not reachable locally, the backend automatically starts
# an in-memory MongoDB (mongodb-memory-server) so the app runs with zero setup.
# Data is then EPHEMERAL: it resets whenever the backend restarts.
#
# >>> DEPLOYMENT (Vercel) <<<
# Vercel serverless functions CANNOT reach a local MongoDB and the in-memory
# fallback is disabled there. You MUST set MONGO_URI in Vercel's dashboard to a
# hosted MongoDB, e.g. MongoDB Atlas (free M0 tier):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quizcraft?retryWrites=true&w=majority
# Steps:
#   1. Create a free cluster at https://www.mongodb.com/atlas
#   2. Add a Database User and allow access from 0.0.0.0/0 (or your IP)
#   3. Copy the connection string and set it as the MONGO_URI env var in Vercel
#   4. Redeploy. Verify with GET /api/health on your live URL.
MONGO_URI=mongodb://127.0.0.1:27017/quizcraft

# JWT authentication secret (use a long random string)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------
# AI API configuration (pick ONE provider).
#
# Option A - OpenAI
#   AI_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o-mini
#
# Option B - Google Gemini
#   AI_PROVIDER=gemini
#   GEMINI_API_KEY=...
#   GEMINI_MODEL=gemini-1.5-flash
#
# If no provider/key is set, the backend will fall back to a
# built-in deterministic generator so the app still works offline.
# ------------------------------------------------------------------
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Admin bootstrap account (created automatically on startup if missing)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@quizcraft.app
ADMIN_PASSWORD=Admin1234!